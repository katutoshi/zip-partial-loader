{
  "name": "zip-partial-loader",
  "version": "0.12.1",
  "description": "A library for partial ZIP file loading using Range Requests",
  "type": "module",
  "main": "./dist/lszl/lszl.js",
  "module": "./dist/lszl/lszl.js",
  "types": "./dist/lszl/lszl.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lszl/lszl.d.ts",
      "import": "./dist/lszl/lszl.js"
    },
    "./worker": {
      "types": "./dist/lszlw/lszlw.d.ts",
      "import": "./dist/lszlw/lszlw.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/lszlw/*.js",
    "./wasm/pkg/*.js",
    "./wasm/pkg/*.wasm"
  ],
  "scripts": {
    "clean": "rm -rf dist lib && cd wasm && rm -rf pkg && cargo clean",
    "build:wasm": "./wasm/build.sh",
    "build:ts": "rm -rf dist && tsc",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "prepack": "$npm_execpath run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "author": "katutoshi",
  "contributors": [
    "Lunascape (original author)"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@vitest/coverage-v8": "4.0.18",
    "msw": "^2.12.8",
    "release-it": "21.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "files": [
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "dist/",
    "wasm/pkg/lszr.js",
    "wasm/pkg/lszr.d.ts",
    "wasm/pkg/lszr_bg.wasm",
    "wasm/pkg/lszr_bg.wasm.d.ts"
  ],
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
