{
  "name": "zip-partial-loader",
  "version": "0.10.0",
  "description": "A library for partial ZIP file loading using Range Requests",
  "main": "dist/lszl.js",
  "types": "dist/lszl.d.ts",
  "scripts": {
    "dev": "webpack serve --open",
    "clean": "rm -rf dist lib && cd wasm && rm -rf pkg && cargo clean",
    "build": "tsc && webpack --config webpack.config.lszl.js --mode=${NODE_ENV:-development}",
    "prepack": "$npm_execpath run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "author": "katutoshi",
  "contributors": [
    "Lunascape (original author)"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@vitest/coverage-v8": "4.0.18",
    "copy-webpack-plugin": "^13.0.1",
    "esbuild-loader": "^4.4.2",
    "mime": "^4.1.0",
    "msw": "^2.12.8",
    "release-it": "21.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "files": [
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "dist/lszl.d.ts",
    "dist/lszl.js",
    "dist/lszlw.js"
  ],
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
